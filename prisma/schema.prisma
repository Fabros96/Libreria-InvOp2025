generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:root@localhost:3306/inv_op"
}

model Inventario {
  idInventario            Int     @id @default(autoincrement())
  costoAlmacenamiento     Int?
  costoCompra             Int?
  costoPedido             Int?
  demandaArticulo         Int?
  loteOptimo              Int?
  puntoPedido             Int?
  stockSeguridad          Int?
  inventarioMaximo        Int?
  periodoRevision         Int?
  articulo                Articulo?
  
}

model Proveedor {
  idProveedor             Int     @id @default(autoincrement())
  fechaBaja               DateTime?
  nombre                  String?
  articuloProveedorList   ArticuloProveedor[]
  ordenCompraList         OrdenCompra[]
}

model Articulo {
  idArticulo              Int     @id @default(autoincrement())
  idInventario            Int     @unique
  fechaBaja               DateTime?
  descripcion             String?
  modeloInventario        String
  stock                   Int
  inventario              Inventario @relation(fields: [idInventario], references: [idInventario])
  articuloProveedorList   ArticuloProveedor[]
  ordenCompraList         OrdenCompra[]
  ventaList               Venta[]
  ajusteInventarioList   AjusteInventario[] // <- Relación 1:N (un usuario tiene muchos posts)
}

model AjusteInventario {
  idAjustesInventario               Int    @id @default(autoincrement())
  cantOrig                Int
  idArticulo              Int
  cantNew                 Int
  fecha                   DateTime
  userName                String
  articulo                Articulo @relation(fields: [idArticulo], references: [idArticulo])
}

model ArticuloProveedor {
  idArticuloProveedor     Int     @id @default(autoincrement())
  idArticulo              Int
  idProveedor             Int
  cargoPedido             Int?
  demoraEntrega           Int?
  esPredeterminado        Boolean?
  precioUnitario          Int?
  articulo                Articulo @relation(fields: [idArticulo], references: [idArticulo])
  proveedor               Proveedor @relation(fields: [idProveedor], references: [idProveedor])
}

model EstadoOrdenCompra {
  idEstadoOrdenCompra     Int     @id @default(autoincrement())
  fechaBaja               DateTime?
  nombre                  String?
  ordenCompraList         OrdenCompra[]
}

model OrdenCompra {
  idOrdenCompra           Int     @id @default(autoincrement())
  idArticulo              Int
  idProveedor             Int
  idEstadoOrdenCompra     Int
  cantidad                Int?
  fechaCreacion           DateTime?
  articulo                Articulo @relation(fields: [idArticulo], references: [idArticulo])
  proveedor               Proveedor @relation(fields: [idProveedor], references: [idProveedor])
  estadoOrdenCompra       EstadoOrdenCompra @relation(fields: [idEstadoOrdenCompra], references: [idEstadoOrdenCompra])
}

model Venta {
  idVenta                 Int     @id @default(autoincrement())
  idArticulo              Int
  cantidad                Int?
  fechaCreacion           DateTime?
  articulo                Articulo @relation(fields: [idArticulo], references: [idArticulo])
}

